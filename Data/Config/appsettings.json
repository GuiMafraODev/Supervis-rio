
{
  "application": {
    "name": "Supervisorio ECA",
    "version": "1.0.0",
    "environment": "production",
    "culture": "pt-BR",
    "readOnly": true
  },
  "opc": {
    "enabled": true,
    "programId": "RSLinx OPC Server",
    "host": "localhost",
    "platform": "x86",
    "updateIntervalMs": 1000,
    "timeoutMs": 5000,
    "reconnectIntervalMs": 5000,
    "maxReconnectAttempts": 0,
    "requiredQuality": "Good",
    "rejectBadQuality": true,
    "rejectUncertainQuality": true,
    "rejectStaleValues": true,
    "staleAfterMs": 5000,
    "writeEnabled": false
  },
  "api": {
    "host": "127.0.0.1",
    "port": 8765,
    "basePath": "/api",
    "corsEnabled": false,
    "remoteAccessEnabled": false
  },
  "storage": {
    "provider": "JSONL",
    "trendsDirectory": "Data/Trends",
    "eventsDirectory": "Data/Events",
    "backupDirectory": "Data/Backup",
    "historyIntervalMs": 5000,
    "retentionDays": 30,
    "automaticBackupIntervalHours": 24,
    "maxTrendQueryResults": 10000,
    "maxEventQueryResults": 2000
  },
  "alarms": {
    "enabled": true,
    "evaluateOnOpcUpdate": true,
    "requireGoodQuality": true,
    "defaultHysteresis": 0.05,
    "popupEnabled": true,
    "soundEnabled": true,
    "requireUserActivationForSound": true,
    "acknowledgementRequired": true,
    "recordTransitions": true
  },
  "logging": {
    "enabled": true,
    "directory": "Data/Events",
    "fileName": "bridge.log",
    "maxFileSizeBytes": 5242880,
    "maxBackupFiles": 10
  },
  "security": {
    "plcWritesAllowed": false,
    "bindOnlyToLocalhost": true,
    "serveOnlyWhitelistedFiles": true
  }
}
