
{
  "application": {
    "name": "Supervisorio ECA",
    "version": "1.0.0",
    "environment": "production",
    "language": "pt-BR",
    "readOnly": true
  },
  "opc": {
    "enabled": true,
    "serverProgId": "RSLinx OPC Server",
    "host": "localhost",
    "clientBitness": "x86",
    "requestedUpdateRateMs": 1000,
    "connectionTimeoutMs": 5000,
    "reconnectIntervalMs": 5000,
    "maxReconnectAttempts": 0,
    "qualityRequired": "Good",
    "rejectBadQuality": true,
    "rejectUncertainQuality": true,
    "rejectStaleValues": true,
    "staleTimeoutMs": 5000,
    "writeEnabled": false
  },
  "api": {
    "host": "127.0.0.1",
    "port": 8765,
    "basePath": "/api",
    "enableCors": false,
    "enableRemoteAccess": false
  },
  "storage": {
    "provider": "SQLite",
    "databaseFile": "Data/supervisorio.db",
    "trendsFolder": "Data/Trends",
    "eventsFolder": "Data/Events",
    "backupFolder": "Data/Backup",
    "historyIntervalMs": 5000,
    "retentionDays": 30,
    "automaticBackup": true,
    "backupIntervalHours": 24
  },
  "alarms": {
    "enabled": true,
    "evaluationMode": "onOpcUpdate",
    "requireGoodQuality": true,
    "defaultHysteresis": 0.05,
    "popupEnabled": true,
    "soundEnabled": true,
    "soundRequiresUserActivation": true,
    "acknowledgementRequired": true,
    "recordAllTransitions": true
  },
  "logging": {
    "enabled": true,
    "folder": "Data/Events",
    "fileName": "bridge.log",
    "maxFileSizeMB": 5,
    "maxFiles": 10,
    "logOpcFailures": true,
    "logReconnects": true
  },
  "security": {
    "allowPlcWrites": false,
    "allowRemoteConnections": false,
    "requireLocalhostApi": true
  }
}
